# Required: Solana validator vote account to monitor.
VOTE_ACCOUNT=YOUR_SOLANA_VOTE_ACCOUNT_HERE

# Human-readable label used in Telegram messages.
MONITOR_NAME=My Validator

# Required for Telegram delivery. Keep the real token out of git.
TELEGRAM_TOKEN=REPLACE_WITH_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=REPLACE_WITH_TELEGRAM_CHAT_ID

# Optional: Telegram forum topic/thread id.
# TELEGRAM_THREAD_ID=123

# Runtime state used for deduplication and recovery alerts.
STATE_FILE=state/marinade-sam-monitor.json

# Bond reserve policy.
MIN_BOND_EPOCHS=4
IDEAL_BOND_EPOCHS=12
ALERT_REPEAT_SEC=43200

# API and status cadence.
API_FAILURE_THRESHOLD=2
API_TIMEOUT_SEC=25
STATUS_EVERY_SEC=86400

# Alert tuning.
ALERT_BIDDING_EVENTS=0
MAX_COMMISSION_PCT=7
BAD_UPTIME_THRESHOLD=0.8
